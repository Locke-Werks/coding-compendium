# secrets
.env
.env.*
*.key
*.pem

# rust / tauri build output
target/
src-tauri/target/
src-tauri/gen/

# node
node_modules/
dist/
.vite/

# build artifacts: content.db is compiled from content/, never edited by hand,
# and never committed. Rebuild it with `pnpm build:content`.
build/
*.db
*.db-shm
*.db-wal

# Model weights. Too large for git and reproducible from a pinned model name.
# The embedding weights do ship: scripts/stage-payload.ps1 copies them out of
# .fastembed_cache into the installer payload. See docs/DECISIONS.md.
src-tauri/vendor/
src-tauri/models/
*.onnx
*.gguf

# operating system clutter
Thumbs.db
desktop.ini
.DS_Store

# Embedding model cache, downloaded by `pnpm build:content` on first use.
# 67 MB of ONNX weights: reproducible from a pinned model name, so it is a
# build artifact rather than source, even though a flattened copy of it ships
# inside the installer.
.fastembed_cache/
