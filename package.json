{
  "name": "coding-compendium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline Windows reference app for software development in the age of coding agents",
  "author": "Locke Werks",
  "scripts": {
    "lint:content": "tsx tools/lint/index.ts",
    "lint:selftest": "tsx tools/lint/selftest.ts",
    "check": "tsc --noEmit && pnpm lint:selftest && pnpm lint:content",
    "build:content": "cargo run --manifest-path src-tauri/Cargo.toml --bin compile-content",
    "eval": "cargo run --manifest-path src-tauri/Cargo.toml --bin evaluate",
    "fetch:vendor": "pwsh -File scripts/fetch-vendor.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
